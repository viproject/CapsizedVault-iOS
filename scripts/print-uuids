#!/usr/bin/env python3
"""List the LC_UUID of every Mach-O file in a .app bundle.

Usage: print-uuids <bundle.app>

Prints one line per binary: "UUID: <uuid> (arm64) <relative-path>". Matches
the format expected when cross-checking against `dwarfdump --uuid` output,
per REPRODUCIBLE_BUILDS.md.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _macho  # noqa: E402


def main(argv):
    if len(argv) != 2:
        print(f"usage: {argv[0]} <bundle.app>", file=sys.stderr)
        return 2
    bundle = argv[1]
    if not os.path.isdir(bundle):
        print(f"error: not a directory: {bundle}", file=sys.stderr)
        return 2

    rc = 0
    for rel in _macho.find_macho_files(bundle):
        full = os.path.join(bundle, rel)
        with open(full, "rb") as f:
            data = f.read()
        slices = list(_macho.iter_slices(data))
        if not slices:
            print(f"warning: could not parse arch slices in {rel}", file=sys.stderr)
            rc = 1
            continue
        for arch, start, size in slices:
            uuid = _macho.read_uuid(data[start : start + size])
            if uuid is None:
                print(f"warning: no LC_UUID found in {rel} ({arch})", file=sys.stderr)
                rc = 1
                continue
            print(f"UUID: {_macho.format_uuid(uuid)} ({arch}) {rel}")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))
